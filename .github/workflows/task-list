name: List gradle tasks
on:
  workflow_dispatch

jobs:
  tasklist:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Setup JDK17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
      - name: chmod
        run: chmod +x gradlew
      - name: 列出打包相关task
        run: ./gradlew :mobile:tasks --group="Build"
