name: List All Tasks
on:
  workflow_dispatch

jobs:
  list:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Setup JDK17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
      - name: chmod
        run: chmod +x gradlew
      - name: 列出mobile模块全部任务
        run: ./gradlew :mobile:tasks --all
